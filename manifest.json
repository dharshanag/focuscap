{
  "manifest_version": 3,
  "name": "Focus Cap",
  "version": "0.1.0",
  "description": "Set a daily time limit for distracting sites, then get blocked until tomorrow.",
  "permissions": ["storage", "webNavigation", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "dashboard.html",
    "default_title": "Focus Cap"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
