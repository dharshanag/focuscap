{
  "manifest_version": 3,
  "name": "Focus Cap",
  "version": "0.1.0",
  "description": "Set a daily time limit for distracting sites, then get blocked until tomorrow.",
  "key": "",
  "permissions": ["storage", "webNavigation", "nativeMessaging", "alarms"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "dashboard.html",
    "default_title": "Focus Cap",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
